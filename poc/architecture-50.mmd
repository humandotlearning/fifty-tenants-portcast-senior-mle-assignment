    UpdateElementStyle(worker, $bgColor="#edf3ff", $fontColor="#172337", $borderColor="#2458b5")
    UpdateElementStyle(postgres, $bgColor="#edf8f6", $fontColor="#172337", $borderColor="#166b69")
    UpdateElementStyle(s3, $bgColor="#edf8f6", $fontColor="#172337", $borderColor="#166b69")
    UpdateElementStyle(vector, $bgColor="#edf8f6", $fontColor="#172337", $borderColor="#166b69")
    UpdateElementStyle(queue, $bgColor="#f6f1f8", $fontColor="#172337", $borderColor="#705580")
    UpdateElementStyle(ingest, $bgColor="#f6f1f8", $fontColor="#172337", $borderColor="#705580")
    UpdateElementStyle(indexer, $bgColor="#f6f1f8", $fontColor="#172337", $borderColor="#705580")
    UpdateElementStyle(logs, $bgColor="#f6f1f8", $fontColor="#172337", $borderColor="#705580")
